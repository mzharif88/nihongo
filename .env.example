# Supabase project for NihonGo! JLPT (Project Settings → API).
# Copy to .env.local for local dev; set the same two values in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# AI engine (admin → AI engine). Server-only: never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Monthly spend cap in USD; runs are refused once it's reached (default 10).
AI_MONTHLY_BUDGET_USD=10
# Newcomer translation spend cap per learner per month, in USD (default 5).
NEWCOMER_MONTHLY_BUDGET_USD=5
