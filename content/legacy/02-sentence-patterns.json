          "text": "わたし",
          "slot": "noun",
          "romaji": "watashi",
          "label": "Subject"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "日本",
          "slot": "place",
