      ],
      "examples": [
        {
          "jp": "わたしは学校で勉強します",
          "en": "I study at school."
        }
      ],
      "notes": "で (de) = at/in (location of action). Different from に!"
    },
    {
      "slug": "pattern-destination",
      "jlpt_level": "N5",
      "title": "Destination — Place に行く",
      "english": "I go to Japan.",
      "template": [
        {
          "text": "わたし",
          "slot": "noun",
          "romaji": "watashi",
          "label": "Subject"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "日本",
          "slot": "place",
          "romaji": "nihon",
          "label": "Destination"
        },
        {
          "text": "に",
          "romaji": "ni",
          "label": "Direction marker"
        },
        {
          "text": "行きます",
          "slot": "verb-masu",
          "romaji": "ikimasu",
          "label": "Verb (go)"
