  "records": [
    {
      "slug": "pattern-basic-identity",
      "jlpt_level": "N5",
      "title": "Basic Identity — Aは Bです",
      "english": "A is B.",
      "template": [
        {
          "text": "わたし",
          "slot": "noun",
          "romaji": "watashi",
          "label": "Subject (I)"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "学生",
          "slot": "noun",
          "romaji": "gakusei",
          "label": "Noun (student)"
        },
        {
          "text": "です",
          "romaji": "desu",
          "label": "Copula (am/is)"
        },
        {
          "text": "か",
          "romaji": "ka",
          "label": "Question marker"
        }
      ],
      "examples": [
        {
          "jp": "わたしは学生ですか",
          "en": "A is B."
        }
      ],
      "notes": "は (wa) marks the topic. です (desu) = am/is/are. Add か at end for question."
    },
    {
      "slug": "pattern-basic-action",
      "jlpt_level": "N5",
      "title": "Basic Action — Subject が Object を Verb",
      "english": "I eat sushi.",
      "template": [
        {
          "text": "わたし",
          "slot": "noun",
          "romaji": "watashi",
          "label": "Subject"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "すし",
          "slot": "noun",
          "romaji": "sushi",
          "label": "Object"
        },
        {
          "text": "を",
          "romaji": "wo",
          "label": "Object marker"
        },
        {
          "text": "食べます",
          "slot": "verb-masu",
          "romaji": "tabemasu",
          "label": "Verb (eat)"
        }
      ],
      "examples": [
        {
          "jp": "わたしはすしを食べます",
          "en": "I eat sushi."
        }
      ],
      "notes": "を (wo) marks the direct object. Verb always comes at the END in Japanese."
    },
    {
      "slug": "pattern-location",
      "jlpt_level": "N5",
      "title": "Location — Place で Action",
      "english": "I study at school.",
      "template": [
        {
          "text": "わたし",
          "slot": "noun",
          "romaji": "watashi",
          "label": "Subject"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "学校",
          "slot": "place",
          "romaji": "gakkou",
          "label": "Place (school)"
        },
        {
          "text": "で",
          "romaji": "de",
          "label": "Location of action"
        },
        {
          "text": "勉強します",
          "slot": "verb-masu",
          "romaji": "benkyou shimasu",
          "label": "Verb (study)"
