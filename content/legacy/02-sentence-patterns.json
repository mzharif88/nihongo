      "title": "With Time — 毎日 Subject Verb",
      "english": "I study Japanese every day.",
      "template": [
        {
          "text": "毎日",
          "slot": "time",
          "romaji": "mainichi",
          "label": "Time (every day)"
        },
        {
          "text": "わたし",
          "slot": "noun",
          "romaji": "watashi",
          "label": "Subject"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "日本語",
          "slot": "noun",
          "romaji": "nihongo",
          "label": "Object (Japanese)"
        },
        {
          "text": "を",
          "romaji": "wo",
          "label": "Object marker"
        },
        {
          "text": "勉強します",
          "slot": "verb-masu",
          "romaji": "benkyou shimasu",
          "label": "Verb (study)"
        }
      ],
      "examples": [
        {
          "jp": "毎日わたしは日本語を勉強します",
          "en": "I study Japanese every day."
        }
      ],
      "notes": "Time expressions usually come first or after the topic. Order: Time → Place → Object → Verb."
    },
    {
      "slug": "pattern-adjective-noun",
      "jlpt_level": "N5",
      "title": "Adjective + Noun",
      "english": "A big dog.",
      "template": [
        {
          "text": "大きい",
          "slot": "i-adj",
          "romaji": "ookii",
          "label": "い-adjective"
        },
        {
          "text": "犬",
          "slot": "noun",
          "romaji": "inu",
          "label": "Noun (dog)"
        }
      ],
      "examples": [
        {
          "jp": "大きい犬",
          "en": "A big dog."
        }
      ],
      "notes": "い-adjectives come BEFORE the noun directly. No connector needed!"
    },
    {
      "slug": "pattern-adjective-sentence",
      "jlpt_level": "N5",
      "title": "Adjective Sentence",
      "english": "Tokyo is big.",
      "template": [
        {
          "text": "東京",
          "slot": "noun",
          "romaji": "toukyou",
          "label": "Topic"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "大きい",
          "slot": "i-adj",
          "romaji": "ookii",
          "label": "い-adjective"
        },
        {
          "text": "です",
          "romaji": "desu",
          "label": "Polite ending"
        }
      ],
      "examples": [
        {
          "jp": "東京は大きいです",
          "en": "Tokyo is big."
        }
      ],
      "notes": "Topic は + adjective + です. For な-adjectives add な before nouns: きれいな花."
    },
    {
      "slug": "pattern-possession",
      "jlpt_level": "N5",
      "title": "Possession — の (no)",
      "english": "This is my book.",
      "template": [
        {
          "text": "これ",
          "slot": "noun",
          "romaji": "kore",
          "label": "Subject (this)"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "わたし",
          "slot": "noun",
          "romaji": "watashi",
          "label": "Owner (I/my)"
        },
        {
          "text": "の",
          "romaji": "no",
          "label": "Possessive の"
        },
        {
          "text": "本",
          "slot": "noun",
          "romaji": "hon",
          "label": "Noun (book)"
        },
        {
          "text": "です",
          "romaji": "desu",
          "label": "Copula"
        }
      ],
      "examples": [
        {
          "jp": "これはわたしの本です",
          "en": "This is my book."
        }
      ],
      "notes": "の (no) = 's (possessive). わたしの本 = my book. 日本の食べ物 = Japanese food."
    },
    {
      "slug": "pattern-negative",
      "jlpt_level": "N5",
      "title": "Negative Sentence",
      "english": "I don't eat meat.",
      "template": [
        {
          "text": "わたし",
          "slot": "noun",
          "romaji": "watashi",
          "label": "Subject"
        },
        {
          "text": "は",
          "romaji": "wa",
          "label": "Topic marker"
        },
        {
          "text": "肉",
          "slot": "noun",
          "romaji": "niku",
          "label": "Object (meat)"
        },
        {
          "text": "を",
          "romaji": "wo",
          "label": "Object marker"
        },
        {
          "text": "食べません",
          "slot": "verb-masu",
          "romaji": "tabemasen",
          "label": "Negative verb"
        }
      ],
      "examples": [
        {
          "jp": "わたしは肉を食べません",
          "en": "I don't eat meat."
        }
      ],
      "notes": "ます (masu) → ません (masen) for negative. です → ではありません."
    },
