    {
      "slug": "practice-n5-002",
      "jlpt_level": "N5",
      "section": "grammar",
      "prompt": "あそこに ねこ ___ います。",
      "options": [
        "は",
        "が",
        "を",
        "で"
      ],
      "answer": 1,
      "explanation": "が marks the grammatical subject. Use が with います (there is, for animate) and あります (there is, for inanimate).\nねこがいます。→ There is a cat.",
      "item_slugs": [
        "grammar-ga-subject"
      ]
    },
    {
      "slug": "practice-n5-003",
